{
  "manifest_version": 3,
  "name": "Inoreader → Obsidian Summary",
  "version": "1.2.0",
  "description": "Inoreaderの有料プランで生成した要約をMarkdownでObsidian Vaultへ保存",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Inoreaderの要約を保存"
  },
  "background": {
    "service_worker": "background.js"
  }
}
